## Ignore Visual Studio temporary files, build results, and files generated by popular Visual Studio add-ons.
## Learn more at https://aka.ms/gitignore

# Build results
bin/
obj/

# Visual Studio cache/options directory
.vs/
.idea/

# MSTest test results
TestResults/

# NUNIT
*.NUnit.log

# .NET Core
artifacts/
**/bin/**
**/obj/**

# Visual Studio 2010/2012 cache/options directory
.vs/

# ReSharper is a .NET coding add-in
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

